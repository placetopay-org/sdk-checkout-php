{
    "name": "placetopay/checkout",
    "description": "Official PHP SDK for the PlaceToPay Checkout API",
    "type": "library",
    "license": "MIT",
    "keywords": ["placetopay", "checkout", "payment", "sdk"],
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "PlaceToPay\\Checkout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlaceToPay\\Checkout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite=Unit",
        "test:integration": "vendor/bin/phpunit --testsuite=Integration",
        "test:coverage": [
            "vendor/bin/phpunit --testsuite=Unit --coverage-clover=coverage.xml",
            "@php bin/check-coverage.php coverage.xml 85"
        ],
        "stan": "vendor/bin/phpstan analyse",
        "cs": "vendor/bin/php-cs-fixer fix",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
